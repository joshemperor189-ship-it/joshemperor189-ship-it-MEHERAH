# =====================================================================
# MEHERAH CORE ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT EXPLICIT PRODUCTION API SECRETS OR MASTER WALLET KEYS
# =====================================================================

# Server Lifecycle Parameters
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database Connection Pool
DATABASE_URL=postgresql://meherah_user:[REDACTED_PASSWORD]@localhost:5432/meherah_ledger_db

# Regulatory Payment Core Infrastructure Binds
NATIONAL_GATEWAY_TOKEN=placeholder_national_gateway_token_for_dev
MTN_MOMO_X_API_KEY=placeholder_mtn_momo_api_key
AIRTEL_MONEY_SECRET_UUID=placeholder_airtel_money_secret_uuid
FLUTTERWAVE_SANDBOX_SECRET=placeholder_flutterwave_sandbox_secret
BEYONIC_API_TOKEN=placeholder_beyonic_api_token

# AI Oversight & Security Guardrails
AI_OVERSIGHT_THRESHOLD=0.90
ENFORCE_EXPLICIT_INTENT_EVIDENCE=true
JWT_SECRET=placeholder_jwt_secret_key_change_in_production

# Base44 Platform & API Connection
BASE44_API_KEY=placeholder_base44_api_key
BASE44_CONNECTOR_URL=https://api.base44.io/v1
